{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/engine.mjs",
    "src/rbac.mjs",
    "src/feature-catalog.mjs",
    "src/internal-errors.mjs",
    "src/recovery.mjs"
  ],
  "testRunner": "tap",
  "tap": {
    "testFiles": [
      "test/engine.test.mjs",
      "test/engine-contract.test.mjs",
      "test/control-plane.test.mjs",
      "test/control-plane-contract.test.mjs",
      "test/recovery.test.mjs"
    ],
    "forceBail": true
  },
  "reporters": [
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "timeoutMS": 15000
}
