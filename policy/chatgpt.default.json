{
  "schemaVersion": 1,
  "policyId": "agm-chatgpt-default",
  "version": 5,
  "strict": true,
  "requireObjective": true,
  "defaults": {
    "unmatched": "ALLOW",
    "criticalUnmatched": "BLOCK"
  },
  "rules": [
    {
      "id": "CHATGPT-BLOCK-DESTRUCTIVE-SHELL",
      "source": "PLUGIN_POLICY",
      "priority": "MANDATORY",
      "status": "ACTIVE",
      "phase": "PRE_ACTION",
      "match": {
        "runtime": [
          "chatgpt-mcp"
        ],
        "tool": [
          "Bash",
          "bash",
          "PowerShell",
          "powershell",
          "shell"
        ],
        "commandRegex": "(^|\\s)(rm\\s+-rf|Remove-Item\\s+.*-Recurse)(\\s|$)"
      },
      "effect": {
        "type": "BLOCK",
        "reason": "Destructive recursive deletion is blocked by the ChatGPT AGM policy."
      }
    },
    {
      "id": "CHATGPT-OWNER-SCOPED-LUNNA-MERGE",
      "source": "USER",
      "priority": "MANDATORY",
      "status": "ACTIVE",
      "phase": "PRE_ACTION",
      "match": {
        "runtime": [
          "chatgpt-mcp"
        ],
        "tool": [
          "mcp__GitHub__merge_pull_request"
        ],
        "actionKind": [
          "merge_pull_request"
        ],
        "commandRegex": "^repository_full_name=odomdowell2030-crypto/lunna\\s+pr_number=[1-9][0-9]*\\s+expected_head_sha=[a-fA-F0-9]{40}$",
        "bindGithubPrToObjective": true,
        "taskLabels": [
          "scope-confirmed",
          "ci-verified",
          "security-reviewed",
          "regression-tests-verified",
          "tenant-isolation-verified"
        ]
      },
      "effect": {
        "type": "REQUIRE_SKILL",
        "skill": "software-repair",
        "executionRequired": true,
        "reason": "Owner-scoped merge requires a directly bound PR, CI, security, regression and repair evidence; Lunna additionally requires tenant isolation. GitHub authenticates the acting user and enforces repository permissions at execution."
      }
    },
    {
      "id": "CHATGPT-OWNER-SCOPED-OTHER-REPO-MERGE",
      "source": "USER",
      "priority": "MANDATORY",
      "status": "ACTIVE",
      "phase": "PRE_ACTION",
      "match": {
        "runtime": [
          "chatgpt-mcp"
        ],
        "tool": [
          "mcp__GitHub__merge_pull_request"
        ],
        "actionKind": [
          "merge_pull_request"
        ],
        "commandRegex": "^repository_full_name=(?:odomdowell2030-crypto/(?:jurisboa|wellington-studio)|agent-guardrail-monitor/agent-guardrail-monitor)\\s+pr_number=[1-9][0-9]*\\s+expected_head_sha=[a-fA-F0-9]{40}$",
        "bindGithubPrToObjective": true,
        "taskLabels": [
          "scope-confirmed",
          "ci-verified",
          "security-reviewed",
          "regression-tests-verified"
        ]
      },
      "effect": {
        "type": "REQUIRE_SKILL",
        "skill": "software-repair",
        "executionRequired": true,
        "reason": "Owner-scoped merge requires a directly bound PR, CI, security, regression and repair evidence; Lunna additionally requires tenant isolation. GitHub authenticates the acting user and enforces repository permissions at execution."
      }
    }
  ]
}
