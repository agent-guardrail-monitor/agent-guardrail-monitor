{
  "schemaVersion": 1,
  "policyId": "agm-chatgpt-default",
  "version": 3,
  "strict": true,
  "requireObjective": true,
  "defaults": {
    "unmatched": "ALLOW",
    "criticalUnmatched": "BLOCK"
  },
  "rules": [
    {
      "id": "CHATGPT-BLOCK-DESTRUCTIVE-SHELL",
      "source": "PLUGIN_POLICY",
      "priority": "MANDATORY",
      "status": "ACTIVE",
      "phase": "PRE_ACTION",
      "match": {
        "runtime": [
          "chatgpt-mcp"
        ],
        "tool": [
          "Bash",
          "bash",
          "PowerShell",
          "powershell",
          "shell"
        ],
        "commandRegex": "(^|\\s)(rm\\s+-rf|Remove-Item\\s+.*-Recurse)(\\s|$)"
      },
      "effect": {
        "type": "BLOCK",
        "reason": "Destructive recursive deletion is blocked by the ChatGPT AGM policy."
      }
    },
    {
      "id": "CHATGPT-JURISBOA-PR32-PRODUCTION-MERGE",
      "source": "USER",
      "priority": "MANDATORY",
      "status": "ACTIVE",
      "phase": "PRE_ACTION",
      "match": {
        "runtime": [
          "chatgpt-mcp"
        ],
        "tool": [
          "GitHub"
        ],
        "actionKind": [
          "merge_pull_request"
        ],
        "commandRegex": "PR #32.*150fbc02b8a58a52f7c5f08f26c2b5367e73a494.*deploy-v4-10-5-pronta",
        "objectiveRegex": "PR #32.*odomdowell2030-crypto/jurisboa.*deploy-v4-10-5-pronta",
        "taskLabels": [
          "jurisboa",
          "PR-32",
          "production",
          "verified-fix",
          "user-approved"
        ]
      },
      "effect": {
        "type": "REQUIRE_SKILL",
        "skill": "software-repair",
        "executionRequired": true,
        "reason": "Jurisboa PR #32 production merge requires a verified Software Repair Engineer execution."
      }
    },
    {
      "id": "CHATGPT-LUNNA-PR249-PRODUCTION-MERGE",
      "source": "USER",
      "priority": "MANDATORY",
      "status": "ACTIVE",
      "phase": "PRE_ACTION",
      "match": {
        "runtime": [
          "chatgpt-mcp"
        ],
        "tool": [
          "GitHub"
        ],
        "actionKind": [
          "merge_pull_request"
        ],
        "commandRegex": "^Merge PR #249 head 545ce9d8a9659a4cd15881d06f4266d696d10996 into main$",
        "objectiveRegex": "PR #249.*odomdowell2030-crypto/lunna.*main",
        "taskLabels": [
          "lunna",
          "PR-249",
          "production",
          "verified-fix",
          "user-approved"
        ]
      },
      "effect": {
        "type": "REQUIRE_SKILL",
        "skill": "software-repair",
        "executionRequired": true,
        "reason": "Lunna PR #249 production merge requires a verified Software Repair Engineer execution."
      }
    }
  ]
}
