      "priority": "MANDATORY",
      "status": "ACTIVE",
      "phase": "PRE_ACTION",
      "match": {
        "runtime": [
          "chatgpt-mcp"
        ],
        "tool": [
          "GitHub"
        ],
        "actionKind": [
          "merge_pull_request"
        ],
        "commandRegex": "PR #32.*150fbc02b8a58a52f7c5f08f26c2b5367e73a494.*deploy-v4-10-5-pronta",
